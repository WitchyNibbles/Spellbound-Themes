{
  "name": "witchynibbles-theme-collection",
  "displayName": "WitchyNibbles Spellbound Themes",
  "description": "Moonlit purple, neon pink, and electric blue themes for focused coding.",
  "version": "1.2.1",
  "publisher": "EimiMartinez",
  "author": {
    "name": "WitchyNibbles"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WitchyNibbles/Spellbound-Themes.git",
    "directory": "."
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "witchy",
    "pastel",
    "neon",
    "purple",
    "pink"
  ],
  "galleryBanner": {
    "color": "#110d24",
    "theme": "dark"
  },
  "icon": "assets/witchynibbles.png",
  "contributes": {
    "themes": [
      {
        "label": "WitchyNibbles Moonlit Candle",
        "uiTheme": "vs-dark",
        "path": "./themes/WitchyNibbles-color-theme-moonlit-candle.json"
      },
      {
        "label": "WitchyNibbles Moonlit",
        "uiTheme": "vs-dark",
        "path": "./themes/WitchyNibbles-color-theme-dark.json"
      },
      {
        "label": "WitchyNibbles Daydream",
        "uiTheme": "vs",
        "path": "./themes/WitchyNibbles-color-theme-light.json"
      },
      {
        "label": "WitchyNibbles Coven Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/WitchyNibbles-color-theme-high-contrast.json"
      }
    ],
    "iconThemes": [
      {
        "id": "witchynibbles-icons",
        "label": "WitchyNibbles Icons",
        "path": "./icons/file-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "witchynibbles-product-icons",
        "label": "WitchyNibbles Product Icons",
        "path": "./icons/product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-themes.mjs && node scripts/build-product-icons.mjs",
    "build:product-icons": "node scripts/build-product-icons.mjs",
    "draw:glyphs": "node scripts/draw-product-glyphs.mjs",
    "glyph-sheet": "node scripts/render-glyph-sheet.mjs",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "package": "npm run build && node scripts/validate.mjs --release && vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/WitchyNibbles/Spellbound-Themes/main --baseContentUrl https://github.com/WitchyNibbles/Spellbound-Themes/blob/main && node scripts/normalize-vsix.mjs",
    "review:gate": "node scripts/review/run-gate.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "fontkit": "2.0.4",
    "svg-pathdata": "7.2.0",
    "svg2ttf": "6.1.0",
    "svgicons2svgfont": "15.0.1",
    "ttf2woff": "3.0.0",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
