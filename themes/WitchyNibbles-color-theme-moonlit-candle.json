  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A99AB9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation",
      "scope": [
        "comment.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#CFC3DB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F3EAF7"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#B99AFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#B99AFF"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B99AFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFD477"
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function.builtin",
        "support.type.builtin",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFD477"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#74E8B8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF9BD7"
      }
    },
    {
      "name": "Booleans and constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FF9BD7"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#D3B4FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#D3B4FF"
      }
    },
    {
      "name": "Class and type names",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#77D9FF"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF86C8"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#9CCBFF"
      }
    },
    {
      "name": "Template placeholders",
      "scope": [
        "variable.other.template",
        "punctuation.definition.variable",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#FFB8E4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "YAML keys and JSON keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9CCBFF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B9F",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#B99AFF",
    "type": "#77D9FF",
    "class": "#77D9FF",
    "enum": "#77D9FF",
    "interface": "#77D9FF",
    "struct": "#77D9FF",
    "typeParameter": "#77D9FF",
    "parameter": "#F6B5DD",
    "variable": "#F3EAF7",
    "property": "#9CCBFF",
    "enumMember": "#FF9BD7",
    "decorator": "#FF67B7",
    "function": "#FFD477",
    "method": "#FFD477",
    "macro": "#FF67B7",
    "comment": "#A99AB9",
    "*.readonly": "#FF9BD7",
    "*.declaration": "#77D9FF",
    "function.declaration": "#FFD477",
    "method.declaration": "#FFD477",
    "variable.declaration": "#F3EAF7",
    "parameter.declaration": "#F6B5DD",
    "property.declaration": "#9CCBFF"
  }
}
